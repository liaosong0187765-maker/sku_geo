{
  "contract_version": "sku-source-passport-assets-v1",
  "asset_type": "sku_source_input_template",
  "scope": {
    "purpose": "Capture evidence-backed product facts for a reusable SKU Source Passport delivery.",
    "target_sku_count": "3-5",
    "allowed_sources": [
      "official_product_page",
      "official_support_page",
      "official_manual",
      "official_faq",
      "official_certification",
      "approved_human_note"
    ],
    "excluded_fields": [
      "price",
      "inventory",
      "ratings",
      "reviews",
      "promotions",
      "rankings"
    ],
    "rules": [
      "Use official or customer-approved evidence only.",
      "Every claim must reference at least one evidence id.",
      "Omit unknown facts instead of guessing.",
      "Do not include price, inventory, ratings, reviews, promotions, or rankings."
    ]
  },
  "brand": {
    "id": "[brand-id]",
    "name": "[Brand Name]",
    "domain": "https://[approved-brand-domain]",
    "market": "[primary-market-or-locale]",
    "official_urls": [
      "https://[approved-brand-domain]",
      "https://[approved-brand-domain]/support"
    ],
    "description": "Short factual brand description approved by the customer."
  },
  "skus": [
    {
      "id": "[sku-1-id]",
      "brand_id": "[brand-id]",
      "product_name": "[SKU 1 Product Name]",
      "category": "[Category Name]",
      "canonical_url": "https://[approved-brand-domain]/products/[sku-1-slug]",
      "model_number": "[SKU-1-MODEL-NUMBER]",
      "status": "draft",
      "source_urls": [
        "https://[approved-brand-domain]/products/[sku-1-slug]",
        "https://[approved-brand-domain]/support/[sku-1-slug]"
